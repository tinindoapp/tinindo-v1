# Ambiente de PRODUÇÃO (D36 a). MODELO: copie para release/ambientes/producao.env só quando o projeto existir e troque
# cada PREENCHER (release/PRODUCAO.md, passo a passo). Só dados públicos: nenhum segredo entra aqui.
# Enquanto houver PREENCHER, publicar.sh e reverter.sh param antes de tocar em qualquer conta.
NOME="produção"
ALVO=supabase
# Projeto Supabase de produção, na organização da empresa, plano com backup diário, região São Paulo.
SUPABASE_REF=PREENCHER
APP_URL=https://PREENCHER.tinindoapp.com.br
# Worker de produção: copiar release/ambientes/wrangler.producao.jsonc.exemplo para a raiz como wrangler.producao.jsonc.
WRANGLER_CONFIG=wrangler.producao.jsonc
VITE_APP_ENV=production
# Só um commit da main com a árvore limpa, com tag vAAAA.MM.DD-N, e a palavra abaixo digitada no terminal.
EXIGE_MAIN=1
EXIGE_TAG=1
CONFIRMAR=producao
