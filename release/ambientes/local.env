# Ambiente local, para testar o publicar.sh sem conta nenhuma: um Postgres descartável (o mesmo das suítes
# db:test:local e test:integration). Aplica as migrations com o mesmo `supabase db push`, só que por --db-url.
# Funções, cron e Worker não existem aqui: os passos dizem que pularam.
NOME="local (banco descartável)"
ALVO=local
APP_URL=http://127.0.0.1:4173
VITE_APP_ENV=local
EXIGE_MAIN=0
