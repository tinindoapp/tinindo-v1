# Copie para .env.local (não versionado). Sem valores = demonstração offline com dados fictícios.
#
# FRONTEND: todo VITE_* vai para o bundle e é PÚBLICO. Só URL e chave pública (publishable/anon).
# O app recusa subir se receber chave secreta aqui.
VITE_APP_ENV=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# Local com `npx supabase start`: VITE_SUPABASE_URL=http://127.0.0.1:54321 e a "Publishable key"
# impressa pelo `npx supabase status`.
#
# BACKEND (Edge Functions): configurar no secret store do projeto Supabase de cada ambiente,
# nunca neste arquivo nem no frontend:
# ALLOWED_ORIGINS=https://app.exemplo,https://homolog.exemplo
# SUPABASE_SECRET_KEY / LLM_API_KEY / WHATSAPP_* / PSP_WEBHOOK_SECRET  (fases futuras)
