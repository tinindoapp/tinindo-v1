{
  "name": "tinindo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:e2e": "playwright test",
    "test:coord": "python3 -m unittest discover -s tests_coordination",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "db:test:local": "bash scripts/db-test-local.sh",
    "db:test:concurrency": "bash scripts/db-concurrency.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
